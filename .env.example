# Public read endpoints only; no Equidia token is used.
EQUIDIA_BASE_URL=https://apiv2.equidia.fr
EQUIDIA_TIMEOUT=30
EQUIDIA_MAX_RETRIES=2
EQUIDIA_TOOL_TIMEOUT=120
EQUIDIA_MAX_RESPONSE_BYTES=8388608
EQUIDIA_CONCURRENCY=4
# Canonical names and aliases accepted; * enables all read tools.
EQUIDIA_ENABLED_TOOLS=*
MCP_HTTP_LISTEN=127.0.0.1:3000
MCP_HTTP_TOKEN=
MCP_HTTP_ALLOWED_HOSTS=
MCP_HTTP_ALLOWED_ORIGINS=
MCP_HTTP_RATE_LIMIT=120
MCP_METRICS_ENABLED=false
MCP_LOG_FORMAT=text
RUST_LOG=warn
# Optional native TLS and mTLS. Alternatively terminate TLS at your reverse proxy.
MCP_TLS_CERT=
MCP_TLS_KEY=
MCP_TLS_CLIENT_CA=
